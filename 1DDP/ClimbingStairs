1. DP (TOP-DOWN) :

T.C. - O(N) , S.C. - O(N)

class Solution:
    def climbStairs(self, n: int) -> int:
        cache = [-1] * n

        def dfs(i):
            if i >= n:
                return i == n
            if cache[i] != -1:
                return cache[i]
            cache[i] = dfs(i+1) + dfs(i+2)
            return cache[i]

        return dfs(0)

2. DP (BOTTOM UP) : T.C. - O(N), S.C. - O(N)

class Solution:
    def climbStairs(self, n: int) -> int:
        
        if n <= 2:
            return n
        dp = [0] * (n+1)

        dp[1], dp[2] = 1,2

        for i in range(3,n+1):
            dp[i] = dp[i-1] + dp[i-2]
        
        return dp[n]

3. DP (SPACE OPTIMISED) :

T.C. - O(N), S.C. - O(1)

class Solution:
    def climbStairs(self, n: int) -> int:
        
        one, two = 1,1

        for i in range(n-1):
            temp = one
            one = one + two
            two = temp
        
        return one

4. MATH : T.C. - O(LOGN), S.C. - O(1)

class Solution:
    def climbStairs(self, n: int) -> int:
        
        sqrt5 = math.sqrt(5)
        phi = (1 + sqrt5) / 2
        psi = (1 - sqrt5) / 2
        n += 1
        return round((phi**n - psi**n) / sqrt5)
