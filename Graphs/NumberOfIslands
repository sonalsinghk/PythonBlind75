1. Depth First Search: T.C. - O(M*N), S.C. - O(M*N)

Approach: If grid[r][c] == 1, then we traverse for +1,0, -1,0 or 0,+1, 0,-1.


class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        ROWS, COLS = len(grid), len(grid[0])
        directions = [[1,0],[-1,0],[0,1],[0,-1]]
        islands = 0

        def dfs(r,c):
            if ( r<0 or c<0 or r>=ROWS or c>=COLS or grid[r][c] == "0"):
                return

            grid[r][c] = "0"

            for dr, dc in directions:
                dfs(r+dr,c+dc)
        
        for r in range(ROWS):
            for c in range(COLS):
                if grid[r][c] == "1":
                    dfs(r,c)
                    islands += 1
        return islands

2. Breadth First Search: T.C. - O(M*N), S.C. - O(M*N)

class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        ROWS, COLS = len(grid), len(grid[0])
        directions = [[1,0],[-1,0],[0,1],[0,-1]]
        islands = 0

        def bfs(r,c):
            q = deque()
            grid[r][c] = "0"
            q.append((r,c))

            while q:
                rows,cols = q.popleft()
                for dr,dc in directions:
        
                    nr, nc = rows+dr,cols+dc

                    if ( nr <0 or nc <0 or nr >= ROWS or nc >= COLS or grid[nr][nc] == "0"):
                        continue

                    q.append((nr,nc))
                    grid[nr][nc] = "0"



        for r in range(ROWS):
            for c in range(COLS):
                if grid[r][c] == "1":
                    bfs(r,c)
                    islands += 1
        return islands
        
