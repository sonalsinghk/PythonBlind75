1. BackTracking : T.C. - O(w*m*n*4*3^t), S.C. - O(t) (TLE)

Approach: Same as the problem solved earlier called word search, here we had to put the found word in list and return it.
For that we have used row and col loop and on top of that a for loop for words, so that for every word to be found, board
is traversed from 0th row and 0th col

class Solution:
    def findWords(self, board: List[List[str]], words: List[str]) -> List[str]:
        ROWS, COLS = len(board), len(board[0])
        res = []

        def backtrack(r, c, i):
            if i == len(word):
                return True
            if (r < 0 or c < 0 or r >= ROWS or
                c >= COLS or board[r][c] != word[i]
            ):
                return False

            board[r][c] = '*'
            ret = (backtrack(r + 1, c, i + 1) or
                   backtrack(r - 1, c, i + 1) or
                   backtrack(r, c + 1, i + 1) or
                   backtrack(r, c - 1, i + 1))
            board[r][c] = word[i]
            return ret

        for word in words:
            flag = False
            for r in range(ROWS):
                if flag:
                    break
                for c in range(COLS):
                    if board[r][c] != word[0]:
                        continue
                    if backtrack(r, c, 0):
                        res.append(word)
                        flag = True
                        break
        return res

2. BACKTRACKING (SET + TRIENODE) : T.C. - O(M*N*4*3^T-1 + S) , S.C. - O(S) - s being the sum of length of all words

Approach: for every word traversing the whole board makes no sense, this dfs algorithm will work according to the node
existing in the trienode. 

class TrieNode:
    def __init__(self):
        self.children = {}
        self.end = False
    
    def addWord(self,word):
        cur = self
        for c in word:
            if c not in cur.children:
                cur.children[c] = TrieNode()
            cur = cur.children[c]
        cur.end = True

class Solution:
    def findWords(self, board: List[List[str]], words: List[str]) -> List[str]:

        root = TrieNode()

        for w in words:
            root.addWord(w)

        ROWS, COLS = len(board), len(board[0])
        res, visit = set(), set()

        def dfs(r,c,node,word):

            if( r < 0 or c < 0 or r >= ROWS or c >= COLS 
                or (r,c) in visit or board[r][c] not in node.children):

                return
            
            visit.add((r,c))
            node = node.children[board[r][c]]
            word += board[r][c]

            if node.end:
                res.add(word)

            dfs(r+1,c,node,word)
            dfs(r-1,c,node,word)
            dfs(r,c+1,node,word)
            dfs(r,c-1,node,word)
            visit.remove((r,c))


        for r in range(ROWS):
            for c in range(COLS):
                dfs(r,c,root,"")
        
        return list(res)
        
